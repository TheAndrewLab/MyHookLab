---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Introduction from '../components/Introduction.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import Solutions from '../components/Solutions.astro';
import Process from '../components/Process.astro';
import WhoWeHelp from '../components/WhoWeHelp.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import ScrollHook from '../components/ScrollHook.astro';
---

<Layout
  title="MyHookLab — Make Them Stop. Make Them Notice."
  description="MyHookLab helps businesses capture attention through powerful hooks, attention-grabbing messaging, and compelling content openings."
>
  <Navbar />
  <ScrollHook />
  <main>
    <Hero />
    <Introduction />
    <WhatWeDo />
    <Solutions />
    <Process />
    <WhoWeHelp />
    <FinalCTA />
    <Contact />
  </main>
  <Footer />
</Layout>
