---
// WhoWeHelp.astro
---

<section id="who-we-help" class="py-16 sm:py-24 md:py-32 border-t border-subtle bg-surface-1/30 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16 sm:mb-20">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-[2px] bg-[#ff4500]"></span>
        <span class="text-xs font-semibold tracking-widest text-dim uppercase">Who We Help</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-main leading-tight mb-6">
        Attention Matters to Everyone.
      </h2>
      <p class="text-lg text-muted font-normal max-w-2xl leading-relaxed">
        Whether you are scaling a company or building individual influence, the challenge is identical: you must win the first second before you can win the relationship.
      </p>
    </div>

    <!-- Two Clean Audience Sections -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Audience 1: Businesses -->
      <div class="p-8 sm:p-10 rounded-2xl bg-surface-card border border-subtle hover:border-zinc-400 dark:hover:border-zinc-600 transition-all duration-200 flex flex-col justify-between group">
        <div>
          <!-- Icon & Category Tag -->
          <div class="flex items-center justify-between mb-8">
            <span class="text-xs font-mono font-bold tracking-widest text-[#ff4500] uppercase">
              Segment 01
            </span>
            <div class="w-12 h-12 rounded-xl bg-surface-1 border border-subtle flex items-center justify-center text-main group-hover:text-[#ff4500] transition-colors">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
          </div>

          <h3 class="text-2xl sm:text-3xl font-bold text-main mb-4">
            Businesses
          </h3>

          <p class="text-base sm:text-lg text-muted leading-relaxed font-normal mb-8">
            For businesses that want their products, services, advertisements, and marketing messages to stand out to potential customers.
          </p>

          <div class="space-y-3 pt-6 border-t border-subtle text-sm text-muted">
            <div class="flex items-start gap-3">
              <span class="mt-1 w-2 h-2 rounded-full bg-[#ff4500] shrink-0"></span>
              <span>Prevent marketing budget from vanishing into unseen ad impressions</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="mt-1 w-2 h-2 rounded-full bg-[#ff4500] shrink-0"></span>
              <span>Turn high bounce rates into extended landing page dwell time</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="mt-1 w-2 h-2 rounded-full bg-[#ff4500] shrink-0"></span>
              <span>Differentiate clearly in commoditized and competitive markets</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-subtle">
          <a
            href="#contact"
            class="inline-flex items-center text-sm font-semibold text-main hover:text-[#ff4500] transition-colors"
          >
            <span>Discuss business hooks</span>
            <svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Audience 2: Individuals & Creators -->
      <div class="p-8 sm:p-10 rounded-2xl bg-surface-card border border-subtle hover:border-zinc-400 dark:hover:border-zinc-600 transition-all duration-200 flex flex-col justify-between group">
        <div>
          <!-- Icon & Category Tag -->
          <div class="flex items-center justify-between mb-8">
            <span class="text-xs font-mono font-bold tracking-widest text-[#ff4500] uppercase">
              Segment 02
            </span>
            <div class="w-12 h-12 rounded-xl bg-surface-1 border border-subtle flex items-center justify-center text-main group-hover:text-[#ff4500] transition-colors">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
          </div>

          <h3 class="text-2xl sm:text-3xl font-bold text-main mb-4">
            Individuals & Creators
          </h3>

          <p class="text-base sm:text-lg text-muted leading-relaxed font-normal mb-8">
            For creators, freelancers, professionals, and individuals who want to communicate their ideas and capture attention.
          </p>

          <div class="space-y-3 pt-6 border-t border-subtle text-sm text-muted">
            <div class="flex items-start gap-3">
              <span class="mt-1 w-2 h-2 rounded-full bg-[#ff4500] shrink-0"></span>
              <span>Break through algorithmic barriers with viral opening frameworks</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="mt-1 w-2 h-2 rounded-full bg-[#ff4500] shrink-0"></span>
              <span>Build an unmistakable signature voice in your industry</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="mt-1 w-2 h-2 rounded-full bg-[#ff4500] shrink-0"></span>
              <span>Transform high-effort content into engaged, loyal audiences</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-subtle">
          <a
            href="#contact"
            class="inline-flex items-center text-sm font-semibold text-main hover:text-[#ff4500] transition-colors"
          >
            <span>Explore creator openings</span>
            <svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

