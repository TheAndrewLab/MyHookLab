---
// FinalCTA.astro
---

<section class="py-16 sm:py-24 md:py-32 border-t border-subtle bg-canvas relative overflow-hidden">
  <!-- Subtle Hook Graphic Background Watermark -->
  <div class="absolute -right-16 -bottom-16 w-96 h-96 opacity-[0.03] dark:opacity-[0.05] pointer-events-none">
    <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="6">
      <path d="M50 10 V60 C50 78, 25 85, 15 70 C10 60, 16 50, 26 50" />
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      
      <!-- Minimalist Lab Tag -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase bg-surface-1 border border-subtle text-muted mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-[#ff4500]"></span>
        <span>Ready to Stop the Scroll?</span>
      </div>

      <!-- Headline -->
      <h2 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-main leading-[1.12] mb-6">
        Stop Being Ignored. <br class="hidden sm:inline" />
        Start Getting Noticed.
      </h2>

      <!-- Supporting text -->
      <p class="text-lg sm:text-xl text-muted font-normal max-w-2xl mx-auto leading-relaxed mb-10">
        Your next customer is out there. Give them a reason to notice you.
      </p>

      <!-- CTA Button -->
      <div>
        <a
          href="#contact"
          class="inline-flex items-center justify-center px-9 py-4 text-base font-semibold rounded-full bg-[#ff4500] text-white hover:bg-[#e03d00] transition-all duration-200 shadow-xl shadow-[#ff4500]/25 hover:shadow-2xl hover:shadow-[#ff4500]/40 hover:-translate-y-0.5 active:translate-y-0 text-center"
        >
          <span>Let's Build Your Hook</span>
          <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

