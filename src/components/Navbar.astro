---
// Navbar.astro
---

<header
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 bg-[#ff4500] text-white border-b border-[#e03d00] shadow-md shadow-[#ff4500]/15 will-change-transform"
  style="transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease; transform: translateY(0);"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Clean Premium Brand Wordmark with Distinctive 'Hook' Typography -->
      <a
        href="#hero"
        id="brand-logo-btn"
        class="flex items-center gap-2.5 group focus:outline-none select-none cursor-pointer active:scale-95 transition-transform duration-150"
        aria-label="MyHookLab Home"
      >
        <!-- Clean White Emblem with Hook Glyph -->
        <div class="w-9 h-9 rounded-xl bg-white flex items-center justify-center text-[#ff4500] transition-all duration-300 group-hover:scale-105 group-active:scale-90 shadow-sm relative overflow-hidden">
          <svg
            id="brand-hook-icon"
            class="w-5 h-5 text-[#ff4500] transition-transform duration-300 group-hover:-rotate-8 group-active:scale-90 group-active:rotate-[-16deg]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="15" cy="5" r="1.75" fill="currentColor" stroke="none" />
            <path d="M15 6.8v7.2a4.5 4.5 0 0 1-9 0 2.3 2.3 0 0 1 2.3-2.3c1.2 0 1.7 0.7 1.7 1.7" />
          </svg>
        </div>

        <!-- Clean Wordmark: Poppins for 'My' & 'Lab', Editorial Serif & Warm Cream for 'Hook' -->
        <div class="flex items-baseline">
          <span class="text-xl font-bold tracking-tight text-white font-['Poppins',sans-serif]">
            My
          </span>
          
          <!-- Distinctive 'Hook' in Playfair Display Serif with subtle warm ivory tint -->
          <span class="font-['Playfair_Display',serif] italic font-black text-2xl tracking-tight text-[#FFF0D4] px-0.5 group-hover:text-white transition-colors duration-200">
            Hook
          </span>

          <span class="text-xl font-bold tracking-tight text-white font-['Poppins',sans-serif]">
            Lab
          </span>
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-white ml-1 opacity-80 group-hover:opacity-100 transition-opacity"></span>
        </div>
      </a>

      <!-- Desktop Navigation Links with Animation-Driven Hover -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        
        <!-- Link 1: Home -->
        <a
          href="#hero"
          class="nav-item group relative px-4 py-2 text-sm font-semibold text-white/95 transition-all duration-200"
        >
          <span class="relative z-10 block transition-transform duration-200 group-hover:-translate-y-0.5">
            Home
          </span>
          <!-- Dynamic Hover Pill -->
          <span class="absolute inset-0 rounded-xl bg-white/0 group-hover:bg-white/15 scale-90 group-hover:scale-100 transition-all duration-200 ease-out -z-0"></span>
          <!-- Kinetic Underline Indicator -->
          <span class="absolute bottom-1 left-4 right-4 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left ease-out"></span>
        </a>

        <!-- Link 2: What We Do -->
        <a
          href="#what-we-do"
          class="nav-item group relative px-4 py-2 text-sm font-semibold text-white/95 transition-all duration-200"
        >
          <span class="relative z-10 block transition-transform duration-200 group-hover:-translate-y-0.5">
            What We Do
          </span>
          <span class="absolute inset-0 rounded-xl bg-white/0 group-hover:bg-white/15 scale-90 group-hover:scale-100 transition-all duration-200 ease-out -z-0"></span>
          <span class="absolute bottom-1 left-4 right-4 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left ease-out"></span>
        </a>

        <!-- Link 3: Our Process -->
        <a
          href="#process"
          class="nav-item group relative px-4 py-2 text-sm font-semibold text-white/95 transition-all duration-200"
        >
          <span class="relative z-10 block transition-transform duration-200 group-hover:-translate-y-0.5">
            Our Process
          </span>
          <span class="absolute inset-0 rounded-xl bg-white/0 group-hover:bg-white/15 scale-90 group-hover:scale-100 transition-all duration-200 ease-out -z-0"></span>
          <span class="absolute bottom-1 left-4 right-4 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left ease-out"></span>
        </a>

        <!-- Link 4: Contact -->
        <a
          href="#contact"
          class="nav-item group relative px-4 py-2 text-sm font-semibold text-white/95 transition-all duration-200"
        >
          <span class="relative z-10 block transition-transform duration-200 group-hover:-translate-y-0.5">
            Contact
          </span>
          <span class="absolute inset-0 rounded-xl bg-white/0 group-hover:bg-white/15 scale-90 group-hover:scale-100 transition-all duration-200 ease-out -z-0"></span>
          <span class="absolute bottom-1 left-4 right-4 h-[2px] bg-white rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left ease-out"></span>
        </a>

      </nav>

      <!-- Desktop Right Actions: Theme Toggle & Animated CTA -->
      <div class="hidden md:flex items-center space-x-4">
        <!-- Theme Toggle -->
        <button
          type="button"
          data-theme-toggle
          class="p-2.5 rounded-full text-white hover:bg-white/15 transition-all border border-transparent hover:border-white/20 focus:outline-none focus:ring-2 focus:ring-white cursor-pointer group"
          aria-label="Toggle theme mode"
          title="Toggle light/dark theme"
        >
          <svg class="w-4 h-4 hidden dark:block transition-transform duration-300 group-hover:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-4 h-4 block dark:hidden text-white transition-transform duration-300 group-hover:-rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- High-Contrast CTA Button with Spring Hover -->
        <a
          href="#contact"
          class="group relative inline-flex items-center justify-center px-5 py-2.5 text-sm font-bold tracking-wide rounded-full text-[#ff4500] bg-white hover:bg-zinc-100 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-black/20 active:scale-95"
        >
          <span>Build My Hook</span>
          <svg class="w-3.5 h-3.5 ml-1.5 text-[#ff4500] transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <!-- Mobile Right Actions: Theme Toggle & Hamburger -->
      <div class="flex items-center space-x-1.5 md:hidden">
        <!-- Mobile Theme Toggle -->
        <button
          type="button"
          data-theme-toggle
          class="p-2.5 rounded-lg text-white hover:bg-white/15 focus:outline-none cursor-pointer"
          aria-label="Toggle theme"
        >
          <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-5 h-5 block dark:hidden text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- Robust Hamburger Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2.5 rounded-xl text-white hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-white cursor-pointer"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle main menu"
        >
          <svg id="menu-icon-open" class="w-6 h-6 block transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Smooth Mobile Dropdown Menu Container (Orange Background) -->
  <div
    id="mobile-menu"
    class="max-h-0 opacity-0 overflow-hidden md:hidden transition-all duration-300 ease-in-out border-b border-[#e03d00] bg-[#ff4500] text-white shadow-xl"
  >
    <div class="px-5 pt-3 pb-6 space-y-2 max-w-7xl mx-auto border-t border-black/10">
      <a
        href="#hero"
        class="mobile-nav-link flex items-center justify-between px-3.5 py-3 rounded-xl text-base font-semibold text-white/95 hover:text-white hover:bg-black/10 transition-colors"
      >
        <span>Home</span>
        <svg class="w-4 h-4 text-white/70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href="#what-we-do"
        class="mobile-nav-link flex items-center justify-between px-3.5 py-3 rounded-xl text-base font-semibold text-white/95 hover:text-white hover:bg-black/10 transition-colors"
      >
        <span>What We Do</span>
        <svg class="w-4 h-4 text-white/70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href="#process"
        class="mobile-nav-link flex items-center justify-between px-3.5 py-3 rounded-xl text-base font-semibold text-white/95 hover:text-white hover:bg-black/10 transition-colors"
      >
        <span>Our Process</span>
        <svg class="w-4 h-4 text-white/70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href="#contact"
        class="mobile-nav-link flex items-center justify-between px-3.5 py-3 rounded-xl text-base font-semibold text-white/95 hover:text-white hover:bg-black/10 transition-colors"
      >
        <span>Contact</span>
        <svg class="w-4 h-4 text-white/70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <!-- Mobile CTA Button -->
      <div class="pt-3">
        <a
          href="#contact"
          class="mobile-nav-link flex items-center justify-center gap-2 w-full px-5 py-3.5 text-sm font-bold rounded-full bg-white text-[#ff4500] hover:bg-zinc-100 transition-colors shadow-md"
        >
          <span>Build My Hook</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function setupNav() {
    const nav = document.getElementById('main-nav');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    let isMenuOpen = false;
    let lastScrollY = window.scrollY;
    let ticking = false;

    function openMobileMenu() {
      isMenuOpen = true;
      menuBtn?.setAttribute('aria-expanded', 'true');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');

      if (mobileMenu) {
        mobileMenu.style.maxHeight = '420px';
        mobileMenu.classList.remove('opacity-0');
        mobileMenu.classList.add('opacity-100');
      }

      if (nav) {
        nav.style.transform = 'translateY(0)';
      }
    }

    function closeMobileMenu() {
      isMenuOpen = false;
      menuBtn?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');

      if (mobileMenu) {
        mobileMenu.style.maxHeight = '0px';
        mobileMenu.classList.remove('opacity-100');
        mobileMenu.classList.add('opacity-0');
      }

      updateNavOnScroll();
    }

    function updateNavOnScroll() {
      if (!nav) return;

      const currentScrollY = window.scrollY;

      // Keep header visible when mobile menu is open
      if (isMenuOpen) {
        nav.style.transform = 'translateY(0)';
        return;
      }

      // At top of page (hero section)
      if (currentScrollY <= 20) {
        nav.style.transform = 'translateY(0)';
        lastScrollY = currentScrollY;
        return;
      }

      // Scroll threshold check for auto-hide
      const scrollDiff = currentScrollY - lastScrollY;

      if (Math.abs(scrollDiff) > 6) {
        if (scrollDiff > 0 && currentScrollY > 90) {
          // Scrolling DOWN: Slide header UP out of view (disappears)
          nav.style.transform = 'translateY(-100%)';
        } else if (scrollDiff < 0) {
          // Scrolling UP: Slide header DOWN into view (comes back)
          nav.style.transform = 'translateY(0)';
        }
        lastScrollY = currentScrollY;
      }
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateNavOnScroll();
          ticking = false;
        });
        ticking = true;
      }
    }

    // Toggle click
    menuBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isMenuOpen) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });

    // Close on link click
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMobileMenu();
      });
    });

    // Close when clicking outside header
    document.addEventListener('click', (e) => {
      if (isMenuOpen && nav && !nav.contains(e.target as Node)) {
        closeMobileMenu();
      }
    });

    // Logo click spring catch animation
    const logoBtn = document.getElementById('brand-logo-btn');
    const hookIcon = document.getElementById('brand-hook-icon');

    logoBtn?.addEventListener('click', () => {
      if (hookIcon) {
        hookIcon.style.transition = 'transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1)';
        hookIcon.style.transform = 'translateY(3px) rotate(-18deg) scale(1.15)';
        setTimeout(() => {
          hookIcon.style.transform = 'translateY(0) rotate(0deg) scale(1)';
        }, 300);
      }
    });

    // Scroll listener
    window.addEventListener('scroll', onScroll, { passive: true });
    updateNavOnScroll();
  }

  setupNav();
  document.addEventListener('astro:after-swap', setupNav);
</script>
