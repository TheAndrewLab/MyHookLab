---
// Process.astro
---

<section id="process" class="py-16 sm:py-24 md:py-32 border-t border-subtle bg-canvas relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16 sm:mb-20">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-[2px] bg-[#ff4500]"></span>
        <span class="text-xs font-semibold tracking-widest text-dim uppercase">Our Methodology</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-main leading-tight mb-6">
        From Being Ignored to Getting Noticed.
      </h2>
      <p class="text-lg text-muted font-normal max-w-2xl leading-relaxed">
        A deliberate, research-backed framework designed to take you from unseen digital noise to commanding the immediate attention of your target market.
      </p>
    </div>

    <!-- 3-Step Process Layout: Horizontal on desktop, Vertical on mobile -->
    <div class="relative">
      
      <!-- Desktop Continuous Connecting Track -->
      <div class="hidden md:block absolute top-12 left-12 right-12 h-[2px] bg-subtle z-0">
        <div class="h-full bg-gradient-to-r from-[#ff4500] via-[#ff4500]/60 to-[#ff4500]/20 w-3/4"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
        
        <!-- Step 01: Understand -->
        <div class="flex flex-col bg-surface-card md:bg-transparent rounded-2xl md:rounded-none p-6 md:p-0 border md:border-none border-subtle">
          <!-- Step Marker -->
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-surface-card border-2 border-[#ff4500] text-main flex items-center justify-center font-bold text-sm shadow-md shadow-[#ff4500]/10">
              01
            </div>
            <span class="text-xs font-mono font-semibold tracking-wider text-[#ff4500] uppercase">
              Phase One
            </span>
          </div>

          <h3 class="text-2xl font-bold text-main mb-3">
            Step 01 — Understand
          </h3>

          <p class="text-muted text-base leading-relaxed font-normal">
            Understand your business, target audience, customer problems, and what makes them pay attention.
          </p>

          <div class="mt-6 pt-4 border-t border-subtle/80 text-xs text-dim">
            Audience analysis & trigger mapping
          </div>
        </div>

        <!-- Step 02: Create -->
        <div class="flex flex-col bg-surface-card md:bg-transparent rounded-2xl md:rounded-none p-6 md:p-0 border md:border-none border-subtle">
          <!-- Step Marker -->
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-surface-card border-2 border-[#ff4500] text-main flex items-center justify-center font-bold text-sm shadow-md shadow-[#ff4500]/10">
              02
            </div>
            <span class="text-xs font-mono font-semibold tracking-wider text-[#ff4500] uppercase">
              Phase Two
            </span>
          </div>

          <h3 class="text-2xl font-bold text-main mb-3">
            Step 02 — Create
          </h3>

          <p class="text-muted text-base leading-relaxed font-normal">
            Develop relevant hooks and attention-grabbing messaging based on your audience and offer.
          </p>

          <div class="mt-6 pt-4 border-t border-subtle/80 text-xs text-dim">
            Pattern interrupt & angle testing
          </div>
        </div>

        <!-- Step 03: Capture -->
        <div class="flex flex-col bg-surface-card md:bg-transparent rounded-2xl md:rounded-none p-6 md:p-0 border md:border-none border-subtle">
          <!-- Step Marker -->
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-surface-card border-2 border-[#ff4500] text-main flex items-center justify-center font-bold text-sm shadow-md shadow-[#ff4500]/10">
              03
            </div>
            <span class="text-xs font-mono font-semibold tracking-wider text-[#ff4500] uppercase">
              Phase Three
            </span>
          </div>

          <h3 class="text-2xl font-bold text-main mb-3">
            Step 03 — Capture
          </h3>

          <p class="text-muted text-base leading-relaxed font-normal">
            Use those hooks across your marketing and content to attract attention and encourage customer engagement.
          </p>

          <div class="mt-6 pt-4 border-t border-subtle/80 text-xs text-dim">
            Deployment & engagement activation
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

