---
// WhatWeDo.astro
---

<section id="what-we-do" class="py-16 sm:py-24 md:py-32 border-t border-subtle bg-canvas relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16 sm:mb-20">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-[2px] bg-[#ff4500]"></span>
        <span class="text-xs font-semibold tracking-widest text-dim uppercase">Our Capabilities</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-main leading-tight mb-6">
        We Turn Attention Into Opportunity.
      </h2>
      <p class="text-lg text-muted font-normal max-w-2xl leading-relaxed">
        Attention is the rarest currency in the modern economy. Here is how we engineer hooks that transform passive scrollers into engaged buyers.
      </p>
    </div>

    <!-- Three Clean Service Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Card 01: Capture Attention -->
      <div class="group relative rounded-2xl p-8 bg-surface-card border border-subtle hover:border-[#ff4500]/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-[#ff4500]/5 flex flex-col justify-between">
        <div>
          <!-- Card Header & Icon -->
          <div class="flex items-center justify-between mb-8">
            <span class="text-xs font-mono font-bold tracking-widest text-[#ff4500] uppercase">
              01 — Capture Attention
            </span>
            <div class="w-12 h-12 rounded-xl bg-surface-1 border border-subtle group-hover:bg-[#ff4500]/10 group-hover:border-[#ff4500]/30 transition-colors flex items-center justify-center text-main group-hover:text-[#ff4500]">
              <!-- Minimalist Magnet/Hook Icon -->
              <svg class="w-6 h-6 transition-transform duration-300 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
              </svg>
            </div>
          </div>

          <h3 class="text-2xl font-bold text-main mb-4 group-hover:text-[#ff4500] transition-colors">
            Capture Attention
          </h3>

          <p class="text-muted text-base leading-relaxed mb-6 font-normal">
            Create powerful opening lines and visual hooks that interrupt scrolling and make people notice your content.
          </p>
        </div>

        <!-- Detail Micro-List -->
        <div class="pt-6 border-t border-subtle text-xs text-dim space-y-2">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[#ff4500]"></span>
            <span>Sub-second scroll interruption</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[#ff4500]"></span>
            <span>Contrast and open loops</span>
          </div>
        </div>
      </div>

      <!-- Card 02: Create Curiosity -->
      <div class="group relative rounded-2xl p-8 bg-surface-card border border-subtle hover:border-[#ff4500]/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-[#ff4500]/5 flex flex-col justify-between">
        <div>
          <!-- Card Header & Icon -->
          <div class="flex items-center justify-between mb-8">
            <span class="text-xs font-mono font-bold tracking-widest text-[#ff4500] uppercase">
              02 — Create Curiosity
            </span>
            <div class="w-12 h-12 rounded-xl bg-surface-1 border border-subtle group-hover:bg-[#ff4500]/10 group-hover:border-[#ff4500]/30 transition-colors flex items-center justify-center text-main group-hover:text-[#ff4500]">
              <!-- Minimalist Keyhole/Curiosity Icon -->
              <svg class="w-6 h-6 transition-transform duration-300 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
          </div>

          <h3 class="text-2xl font-bold text-main mb-4 group-hover:text-[#ff4500] transition-colors">
            Create Curiosity
          </h3>

          <p class="text-muted text-base leading-relaxed mb-6 font-normal">
            Give your audience a reason to stay, explore, and discover what you offer.
          </p>
        </div>

        <!-- Detail Micro-List -->
        <div class="pt-6 border-t border-subtle text-xs text-dim space-y-2">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[#ff4500]"></span>
            <span>Information gap architecture</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[#ff4500]"></span>
            <span>Sustained dwell-time framing</span>
          </div>
        </div>
      </div>

      <!-- Card 03: Encourage Action -->
      <div class="group relative rounded-2xl p-8 bg-surface-card border border-subtle hover:border-[#ff4500]/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-[#ff4500]/5 flex flex-col justify-between">
        <div>
          <!-- Card Header & Icon -->
          <div class="flex items-center justify-between mb-8">
            <span class="text-xs font-mono font-bold tracking-widest text-[#ff4500] uppercase">
              03 — Encourage Action
            </span>
            <div class="w-12 h-12 rounded-xl bg-surface-1 border border-subtle group-hover:bg-[#ff4500]/10 group-hover:border-[#ff4500]/30 transition-colors flex items-center justify-center text-main group-hover:text-[#ff4500]">
              <!-- Minimalist Forward Arrow/Action Icon -->
              <svg class="w-6 h-6 transition-transform duration-300 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </div>
          </div>

          <h3 class="text-2xl font-bold text-main mb-4 group-hover:text-[#ff4500] transition-colors">
            Encourage Action
          </h3>

          <p class="text-muted text-base leading-relaxed mb-6 font-normal">
            Build compelling messaging that moves interested people toward the next step.
          </p>
        </div>

        <!-- Detail Micro-List -->
        <div class="pt-6 border-t border-subtle text-xs text-dim space-y-2">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[#ff4500]"></span>
            <span>Seamless curiosity-to-click transition</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[#ff4500]"></span>
            <span>Frictionless conversion openings</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

