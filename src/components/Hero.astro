---
// Hero.astro
---

<section id="hero" class="relative pt-28 pb-16 md:pt-36 md:pb-24 overflow-hidden">
  <!-- Subtle Lab Grid Background -->
  <div class="absolute inset-0 -z-10 pointer-events-none opacity-[0.03] dark:opacity-[0.04]">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="lab-grid" width="48" height="48" patternUnits="userSpaceOnUse">
          <path d="M 48 0 L 0 0 0 48" fill="none" stroke="currentColor" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#lab-grid)" />
    </svg>
  </div>

  <!-- Ambient Glow Behind Hero -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] sm:w-[550px] h-[300px] sm:h-[420px] bg-[#ff4500]/5 dark:bg-[#ff4500]/10 rounded-full blur-3xl -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Left Column: High-Impact Typography & CTAs (Preserved untouched) -->
      <div class="lg:col-span-7 flex flex-col justify-center text-left">
        
        <!-- Lab Badge -->
        <div class="inline-flex items-center gap-2 self-start px-3 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase bg-surface-1 border border-subtle text-muted mb-6 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-[#ff4500] animate-ping"></span>
          <span>Attention Engineering Lab</span>
          <span class="text-dim">/</span>
          <span class="text-[#ff4500]">0.4s Window</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-main leading-[1.1] mb-6 font-['Poppins',sans-serif]">
          In a World Full of Noise, Be the <span class="relative inline-block text-[#ff4500] font-black">
            HOOK
            <svg class="absolute -bottom-1 left-0 w-full h-2 text-[#ff4500]/40" viewBox="0 0 100 10" preserveAspectRatio="none">
              <path d="M0 5 Q 50 10, 100 5" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round" />
            </svg>
          </span>.
        </h1>

        <!-- Supporting Text -->
        <p class="text-base sm:text-lg md:text-xl text-muted font-normal max-w-xl leading-relaxed mb-8 sm:mb-10">
          We help businesses capture attention, spark curiosity, and turn potential customers into interested buyers.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4 mb-8 sm:mb-10">
          <a
            href="#contact"
            class="inline-flex items-center justify-center px-7 py-3.5 sm:px-8 sm:py-4 text-sm sm:text-base font-semibold rounded-full bg-[#ff4500] text-white hover:bg-[#e03d00] transition-all duration-200 shadow-lg shadow-[#ff4500]/25 hover:shadow-xl hover:shadow-[#ff4500]/35 hover:-translate-y-0.5 active:translate-y-0 text-center"
          >
            <span>Get Your Hook</span>
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          
          <a
            href="#what-we-do"
            class="inline-flex items-center justify-center px-7 py-3.5 sm:px-8 sm:py-4 text-sm sm:text-base font-medium rounded-full bg-surface-1 hover:bg-surface-2 text-main border border-subtle hover:border-zinc-400 dark:hover:border-zinc-600 transition-all duration-200 text-center"
          >
            Explore What We Do
          </a>
        </div>

        <!-- Micro Philosophy Footer -->
        <div class="flex flex-wrap items-center gap-5 sm:gap-6 pt-6 border-t border-subtle text-xs text-dim">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#ff4500]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Pattern-interrupt architecture</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#ff4500]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Scroll-stop tested</span>
          </div>
        </div>

      </div>

      <!-- Right Column: MINIMAL, PREMIUM FALLING-HOOK ANIMATION -->
      <div class="lg:col-span-5 flex flex-col items-center justify-center w-full">
        
        <!-- Dark Charcoal Showcase Canvas (#0B0B0B) -->
        <div class="w-full max-w-[360px] sm:max-w-[420px] relative">
          
          <div
            id="hook-stage-container"
            class="relative h-[430px] sm:h-[470px] w-full rounded-3xl bg-[#0B0B0B] border border-zinc-800/90 shadow-2xl overflow-hidden flex flex-col items-center justify-center select-none"
          >
            <!-- Stage Top Bar (Subtle & Minimalist) -->
            <div class="absolute top-0 left-0 right-0 px-4 py-3 flex items-center justify-between border-b border-zinc-900/80 z-30">
              <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-zinc-700"></span>
                <span class="w-2 h-2 rounded-full bg-zinc-800"></span>
                <span class="w-2 h-2 rounded-full bg-zinc-800"></span>
              </div>

              <!-- Replay Trigger (Discrete, for testing & re-watching) -->
              <button
                type="button"
                id="replay-falling-hook"
                class="flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-mono text-zinc-400 hover:text-zinc-200 bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800 transition-colors cursor-pointer"
                title="Replay Falling Hook Animation"
                aria-label="Replay Falling Hook Animation"
              >
                <svg class="w-3 h-3 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>Replay</span>
              </button>
            </div>

            <!-- Central Animation Viewport -->
            <div class="relative w-full h-full flex flex-col items-center justify-center pt-8 pb-4 px-4 overflow-hidden">
              
              <!-- COMBINED ASSEMBLY: Hook + Floating Content Card -->
              <div
                id="card-and-hook-assembly"
                class="relative flex flex-col items-center will-change-transform"
                style="transform: translateY(0);"
              >
                
                <!-- REALISTIC METALLIC SILVER FISHING HOOK -->
                <div
                  id="falling-silver-hook"
                  class="absolute left-1/2 -translate-x-1/2 bottom-[calc(100%-14px)] pointer-events-none z-20 will-change-transform"
                  style="transform: translateY(-240px);"
                >
                  <!-- Fine Steel Trace / Suspension Line -->
                  <div class="w-[1.5px] h-48 bg-gradient-to-b from-transparent via-zinc-400 to-zinc-300 mx-auto opacity-75"></div>

                  <!-- Realistic Metallic Silver Fishing Hook Vector -->
                  <div class="relative -mt-0.5 flex items-center justify-center">
                    <svg
                      class="w-16 h-24 filter drop-shadow-[0_8px_16px_rgba(0,0,0,0.6)]"
                      viewBox="0 0 54 80"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <defs>
                        <!-- Linear Metallic Gradient for Cylindrical Steel Shank -->
                        <linearGradient id="silverShankGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                          <stop offset="0%" stop-color="#4B5563" />
                          <stop offset="25%" stop-color="#9CA3AF" />
                          <stop offset="45%" stop-color="#FFFFFF" />
                          <stop offset="70%" stop-color="#D1D5DB" />
                          <stop offset="100%" stop-color="#374151" />
                        </linearGradient>

                        <!-- Radial Specular Reflection for the Circular Eyelet -->
                        <radialGradient id="silverEyeletGrad" cx="35%" cy="35%" r="65%">
                          <stop offset="0%" stop-color="#FFFFFF" />
                          <stop offset="40%" stop-color="#D1D5DB" />
                          <stop offset="80%" stop-color="#6B7280" />
                          <stop offset="100%" stop-color="#1F2937" />
                        </radialGradient>

                        <!-- Subtle Catch Highlight at Point -->
                        <linearGradient id="silverPointGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                          <stop offset="0%" stop-color="#FFFFFF" />
                          <stop offset="50%" stop-color="#E5E7EB" />
                          <stop offset="100%" stop-color="#4B5563" />
                        </linearGradient>
                      </defs>

                      <!-- Top Ring Eyelet (Outer) -->
                      <circle cx="27" cy="8" r="5" fill="url(#silverEyeletGrad)" stroke="#374151" stroke-width="1" />
                      <!-- Top Ring Eyelet (Inner Hole) -->
                      <circle cx="27" cy="8" r="2.2" fill="#0B0B0B" />

                      <!-- Main Vertical Cylindrical Shank -->
                      <path
                        d="M25 12.5 H29 V48 H25 Z"
                        fill="url(#silverShankGrad)"
                      />

                      <!-- Sweeping Metallic Bend & Razor Sharp Barb Catching Under Card -->
                      <path
                        d="M29 47.5 
                           C29 64, 11 64, 11 50 
                           C11 41, 19 40, 20.5 45
                           L18.5 48.5
                           L16 46
                           C15 44, 14 44.5, 14 50
                           C14 59.5, 26 59.5, 26 47.5
                           Z"
                        fill="url(#silverPointGrad)"
                        stroke="#1F2937"
                        stroke-width="0.75"
                        stroke-linejoin="round"
                      />

                      <!-- Specular Chrome Ridge Highlight on Outer Spine -->
                      <path
                        d="M28 14 V48 C28 62, 12.5 62, 12.5 50"
                        stroke="#FFFFFF"
                        stroke-width="0.8"
                        stroke-linecap="round"
                        opacity="0.85"
                      />
                    </svg>
                  </div>
                </div>

                <!-- SIMPLE WHITE SOCIAL MEDIA CONTENT CARD -->
                <div
                  id="floating-white-card"
                  class="relative w-[275px] sm:w-[305px] rounded-2xl bg-white p-4 sm:p-5 text-zinc-900 border border-zinc-200/90 shadow-[0_12px_28px_-6px_rgba(0,0,0,0.45),0_4px_10px_-2px_rgba(0,0,0,0.25)] will-change-transform transition-all"
                >
                  <!-- Card Header: Profile Info -->
                  <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2.5">
                      <!-- Sleek Minimalist Avatar -->
                      <div class="w-8 h-8 rounded-full bg-zinc-900 flex items-center justify-center text-white text-[11px] font-bold font-['Poppins',sans-serif]">
                        M
                      </div>
                      <div>
                        <div class="text-xs font-bold text-zinc-900 leading-tight font-['Poppins',sans-serif]">
                          MyHookLab
                        </div>
                        <div class="text-[10px] text-zinc-500 font-normal font-['Poppins',sans-serif]">
                          @attention • 0.4s
                        </div>
                      </div>
                    </div>

                    <!-- Subtle Status Pill -->
                    <span
                      id="card-status-pill"
                      class="text-[9px] font-mono font-semibold px-2 py-0.5 rounded-full bg-zinc-100 text-zinc-600 transition-colors duration-300"
                    >
                      FEED
                    </span>
                  </div>

                  <!-- Hook Statement Content -->
                  <div class="space-y-1.5 mb-3.5 text-left">
                    <p class="text-xs sm:text-[13px] font-semibold text-zinc-900 leading-snug font-['Poppins',sans-serif]">
                      "People cannot become customers if they never notice you first."
                    </p>
                    <p class="text-[11px] text-zinc-500 font-normal leading-relaxed font-['Poppins',sans-serif]">
                      The right hook makes them stop the scroll.
                    </p>
                  </div>

                  <!-- Minimal Engagement Rail -->
                  <div class="flex items-center justify-between pt-2.5 border-t border-zinc-100 text-zinc-400 text-[10px] font-['Poppins',sans-serif]">
                    <div class="flex items-center gap-3">
                      <!-- Heart -->
                      <span class="flex items-center gap-1 text-zinc-500">
                        <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                        </svg>
                        <span>Stop-Rate</span>
                      </span>
                      <!-- Comment -->
                      <span class="flex items-center gap-1 text-zinc-500">
                        <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                        </svg>
                        <span>Noticed</span>
                      </span>
                    </div>

                    <span class="font-mono text-[9px] text-[#ff4500] font-bold">
                      94% HOOK
                    </span>
                  </div>

                </div>

              </div>

            </div>

            <!-- Stage Bottom Sub-Label -->
            <div class="absolute bottom-2.5 left-4 right-4 flex items-center justify-between text-[10px] text-zinc-500 font-mono">
              <span>Attention Capture</span>
              <span id="motion-phase-indicator" class="text-zinc-400">Natural Gravity</span>
            </div>

          </div>

          <!-- Subtle Dark Base Ambient Shadow -->
          <div class="absolute -bottom-5 left-1/2 -translate-x-1/2 w-4/5 h-10 bg-black/40 rounded-full blur-xl -z-10"></div>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- Falling Hook Animation Engine: Natural gravity, smooth catch & gentle upward lift in a seamless loop -->
<script>
  function initFallingHookAnimation() {
    const heroSection = document.getElementById('hero');
    const hook = document.getElementById('falling-silver-hook');
    const card = document.getElementById('floating-white-card');
    const assembly = document.getElementById('card-and-hook-assembly');
    const statusPill = document.getElementById('card-status-pill');
    const indicator = document.getElementById('motion-phase-indicator');
    const replayBtn = document.getElementById('replay-falling-hook');

    if (!hook || !card || !assembly) return;

    let isAnimating = false;
    let isHeroVisible = true;
    let timeouts: number[] = [];
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function clearScheduledTimers() {
      timeouts.forEach(t => window.clearTimeout(t));
      timeouts = [];
    }

    function schedule(fn: () => void, ms: number) {
      const id = window.setTimeout(fn, ms);
      timeouts.push(id);
      return id;
    }

    function resetStage() {
      hook.style.transition = 'none';
      hook.style.transform = 'translateY(-240px)';

      card.style.transition = 'none';
      card.style.transform = 'translateY(0) rotate(0deg)';
      card.style.boxShadow = '0 12px 28px -6px rgba(0, 0, 0, 0.45), 0 4px 10px -2px rgba(0, 0, 0, 0.25)';

      assembly.style.transition = 'none';
      assembly.style.transform = 'translateY(0)';

      if (statusPill) {
        statusPill.className = 'text-[9px] font-mono font-semibold px-2 py-0.5 rounded-full bg-zinc-100 text-zinc-600 transition-colors duration-300';
        statusPill.innerText = 'FEED';
      }
      if (indicator) {
        indicator.innerText = 'Natural Gravity';
      }
    }

    function playAnimationCycle() {
      clearScheduledTimers();
      isAnimating = true;

      resetStage();

      if (prefersReducedMotion) {
        // Immediate static caught state for reduced motion accessibility
        hook.style.transform = 'translateY(22px)';
        card.style.transform = 'translateY(-8px)';
        if (statusPill) {
          statusPill.className = 'text-[9px] font-mono font-semibold px-2 py-0.5 rounded-full bg-zinc-900 text-white';
          statusPill.innerText = 'HOOKED';
        }
        if (indicator) indicator.innerText = 'Attention Caught';
        isAnimating = false;
        return;
      }

      // Step 1: Gentle initial hover of the floating card
      void hook.offsetHeight;
      card.style.transition = 'transform 0.6s cubic-bezier(0.25, 1, 0.5, 1)';
      card.style.transform = 'translateY(2px)';

      // Step 2: Realistic metallic silver hook enters from top with natural gravity easing
      schedule(() => {
        if (indicator) indicator.innerText = 'Falling Hook...';
        // Smooth natural fall from -240px down to catch the top edge of the card
        hook.style.transition = 'transform 0.85s cubic-bezier(0.33, 1, 0.68, 1)';
        hook.style.transform = 'translateY(22px)';
      }, 400);

      // Step 3: Hook catches the card and gently pulls it upward
      schedule(() => {
        if (indicator) indicator.innerText = 'Tug & Catch';

        // Gentle upward pull on the card & hook assembly
        assembly.style.transition = 'transform 0.45s cubic-bezier(0.25, 1, 0.5, 1)';
        assembly.style.transform = 'translateY(-14px)';

        // Subtle dynamic tilt as the hook catches the card
        card.style.transition = 'transform 0.45s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.45s ease';
        card.style.transform = 'rotate(-0.8deg)';
        card.style.boxShadow = '0 20px 36px -8px rgba(0, 0, 0, 0.6), 0 8px 16px -4px rgba(0, 0, 0, 0.35)';

        if (statusPill) {
          statusPill.className = 'text-[9px] font-mono font-bold px-2 py-0.5 rounded-full bg-zinc-900 text-white transition-colors duration-300';
          statusPill.innerText = 'HOOKED';
        }
      }, 1250);

      // Step 4: Let everything settle smoothly into place
      schedule(() => {
        if (indicator) indicator.innerText = 'Settled • Attention Held';

        assembly.style.transition = 'transform 0.65s cubic-bezier(0.34, 1.3, 0.64, 1)';
        assembly.style.transform = 'translateY(-8px)';

        card.style.transition = 'transform 0.65s cubic-bezier(0.34, 1.3, 0.64, 1)';
        card.style.transform = 'rotate(0deg)';
      }, 1700);

      // Step 5: Hold attention, then gently release and reel up for the next loop
      schedule(() => {
        if (indicator) indicator.innerText = 'Releasing...';

        // Hook smoothly reels upward back into the top
        hook.style.transition = 'transform 0.75s cubic-bezier(0.4, 0, 0.2, 1)';
        hook.style.transform = 'translateY(-240px)';

        // Assembly eases back to neutral ground
        assembly.style.transition = 'transform 0.6s cubic-bezier(0.25, 1, 0.5, 1)';
        assembly.style.transform = 'translateY(0)';

        // Card gently settles back into initial floating feed state
        card.style.transition = 'transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.6s ease';
        card.style.transform = 'translateY(0) rotate(0deg)';
        card.style.boxShadow = '0 12px 28px -6px rgba(0, 0, 0, 0.45), 0 4px 10px -2px rgba(0, 0, 0, 0.25)';

        if (statusPill) {
          statusPill.className = 'text-[9px] font-mono font-semibold px-2 py-0.5 rounded-full bg-zinc-100 text-zinc-600 transition-colors duration-300';
          statusPill.innerText = 'FEED';
        }
      }, 4500);

      // Step 6: Brief natural breath, then smoothly start next loop cycle
      schedule(() => {
        isAnimating = false;
        if (isHeroVisible && !document.hidden) {
          playAnimationCycle();
        }
      }, 5600);
    }

    // Observer to pause loop when scrolled away, saving performance & battery
    if (heroSection && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const wasVisible = isHeroVisible;
            isHeroVisible = entry.isIntersecting;
            if (!wasVisible && isHeroVisible && !isAnimating) {
              playAnimationCycle();
            }
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(heroSection);
    }

    // Visibility change handler (tab switching)
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && isHeroVisible && !isAnimating) {
        playAnimationCycle();
      }
    });

    // Start initial loop
    playAnimationCycle();

    // Replay button listener: immediate restart and continue loop
    replayBtn?.addEventListener('click', () => {
      isAnimating = false;
      playAnimationCycle();
    });
  }

  initFallingHookAnimation();
  document.addEventListener('astro:after-swap', initFallingHookAnimation);
</script>
